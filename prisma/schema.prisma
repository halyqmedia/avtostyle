generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dealsAssigned    Deal[]            @relation("DealAssignee")
  dealsCreated     Deal[]            @relation("DealCreator")
  stageMoves       StageHistory[]
  dealNotes        DealNote[]
  whatsappMessages WhatsAppMessage[]
  productionOrders ProductionOrder[] @relation("ProductionOrderCreator")

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  label       String
  description String?
  isSystem    Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("roles")
}

model Permission {
  id     String           @id @default(cuid())
  key    String           @unique
  label  String
  module String
  roles  RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model PipelineStage {
  id        String   @id @default(cuid())
  pipeline  String
  key       String
  name      String
  color     String
  order     Int
  isDefault Boolean  @default(false)
  isFinal   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealsIn            Deal[]            @relation("DealStage")
  productionOrdersIn ProductionOrder[] @relation("ProductionOrderStage")
  fromMoves          StageHistory[]    @relation("FromStage")
  toMoves            StageHistory[]    @relation("ToStage")

  @@unique([pipeline, key])
  @@unique([pipeline, order])
  @@map("pipeline_stages")
}

model Client {
  id         String   @id @default(cuid())
  fullName   String
  phone      String?  @unique
  whatsappId String?
  email      String?
  source     String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deals      Deal[]

  @@map("clients")
}

model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String?  @unique
  price     Decimal  @db.Decimal(12, 2)
  cost      Decimal  @db.Decimal(12, 2)
  unit      String   @default("шт")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deals     Deal[]

  @@map("products")
}

model Deal {
  id              String        @id @default(cuid())
  title           String
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  prepayment      Decimal       @default(0) @db.Decimal(12, 2)
  pipelineStageId String
  pipelineStage   PipelineStage @relation("DealStage", fields: [pipelineStageId], references: [id], onDelete: Restrict)
  assignedToId    String?
  assignedTo      User?         @relation("DealAssignee", fields: [assignedToId], references: [id])
  createdById     String
  createdBy       User          @relation("DealCreator", fields: [createdById], references: [id])
  source          String?
  comment         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  notes            DealNote[]
  whatsappMessages WhatsAppMessage[]
  productionOrders ProductionOrder[]

  @@index([assignedToId])
  @@index([pipelineStageId])
  @@map("deals")
}

/// Free-text notes a sales rep logs against a deal — multiple entries over time, each editable by its author.
model DealNote {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@map("deal_notes")
}

/// Two-way WhatsApp message log per deal (inbound from client, outbound sent from the CRM).
model WhatsAppMessage {
  id                String   @id @default(cuid())
  dealId            String
  deal              Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  direction         String // "IN" | "OUT"
  body              String
  messageType       String   @default("text") // text | image | document | audio | video
  mediaUrl          String? // our bucket URL — Meta's own media links expire after 5 days
  mediaMimeType     String?
  fileName          String?
  whatsappMessageId String?
  status            String   @default("SENT") // SENT | DELIVERED | READ | FAILED — synced from Cloud API status webhooks
  errorMessage      String?
  sentById          String?
  sentBy            User?    @relation(fields: [sentById], references: [id])
  createdAt         DateTime @default(now())

  @@index([dealId])
  @@index([whatsappMessageId])
  @@map("whatsapp_messages")
}

/// Generic audit trail, reused for ProductionOrder etc. in later phases.
model StageHistory {
  id          String         @id @default(cuid())
  entityType  String
  entityId    String
  fromStageId String?
  fromStage   PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id])
  toStageId   String
  toStage     PipelineStage  @relation("ToStage", fields: [toStageId], references: [id])
  movedById   String
  movedBy     User           @relation(fields: [movedById], references: [id])
  movedAt     DateTime       @default(now())
  note        String?
  photoUrl    String? // optional proof-of-stage photo (bucket key) — production conveyor mainly

  @@index([entityType, entityId])
  @@map("stage_history")
}

/// Manufacturing order a sales manager opens for the production department once a deal is sold.
/// Moves through PipelineStage rows where pipeline = "PRODUCTION"; every stage move is logged in
/// StageHistory (entityType = "PRODUCTION_ORDER") for per-step worker attribution and audit.
model ProductionOrder {
  id              String        @id @default(cuid())
  dealId          String?
  deal            Deal?         @relation(fields: [dealId], references: [id])
  clientName      String
  clientPhone     String
  city            String?
  address         String?
  carBrand        String?
  carYear         String?
  carGeneration   String?
  paymentAmount   Decimal       @default(0) @db.Decimal(12, 2)
  paymentType     String? // cash | card | transfer
  remainingAmount Decimal       @default(0) @db.Decimal(12, 2)
  note            String?
  pipelineStageId String
  pipelineStage   PipelineStage @relation("ProductionOrderStage", fields: [pipelineStageId], references: [id], onDelete: Restrict)
  createdById     String
  createdBy       User          @relation("ProductionOrderCreator", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items ProductionOrderItem[]

  @@index([pipelineStageId])
  @@index([dealId])
  @@map("production_orders")
}

/// One product line within a production order — a client can order several items in one заявка.
model ProductionOrderItem {
  id               String          @id @default(cuid())
  orderId          String
  order            ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productType      String
  materialPhotoUrl String? // bucket key
  createdAt        DateTime        @default(now())

  @@index([orderId])
  @@map("production_order_items")
}

/// Canned response a manager can insert into the WhatsApp draft with one click.
model QuickReply {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quick_replies")
}

/// Raw log of inbound webhook payloads (WhatsApp lead intake), for debugging/replay.
model InboundWebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  rawPayload Json
  dealId     String?
  processed  Boolean  @default(false)
  error      String?
  receivedAt DateTime @default(now())

  @@map("inbound_webhook_events")
}

