generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  phone          String?
  roleId         String
  role           Role     @relation(fields: [roleId], references: [id])
  isActive       Boolean  @default(true)
  commissionRate Decimal? @db.Decimal(5, 2) // % of each payment they receive as commission (sales staff)
  photoUrl       String? // bucket key
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dealsAssigned      Deal[]            @relation("DealAssignee")
  dealsCreated       Deal[]            @relation("DealCreator")
  stageMoves         StageHistory[]
  dealNotes          DealNote[]
  whatsappMessages   WhatsAppMessage[]
  productionOrders   ProductionOrder[] @relation("ProductionOrderCreator")
  purchaseOrders     PurchaseOrder[]
  stockMovements     StockMovement[]
  transactionsAbout  Transaction[]     @relation("TransactionUser")
  transactionsLogged Transaction[]     @relation("TransactionCreator")
  aiSettingsUpdates  AiSettings[]
  whatsappSession    WhatsAppSession?
  whatsappTemplates  WhatsAppTemplate[]
  campaigns          Campaign[]
  contacts           Contact[]

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  label       String
  description String?
  isSystem    Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("roles")
}

model Permission {
  id     String           @id @default(cuid())
  key    String           @unique
  label  String
  module String
  roles  RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model PipelineStage {
  id        String   @id @default(cuid())
  pipeline  String
  key       String
  name      String
  color     String
  order     Int
  isDefault Boolean  @default(false)
  isFinal   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealsIn            Deal[]            @relation("DealStage")
  productionOrdersIn ProductionOrder[] @relation("ProductionOrderStage")
  fromMoves          StageHistory[]    @relation("FromStage")
  toMoves            StageHistory[]    @relation("ToStage")

  @@unique([pipeline, key])
  @@unique([pipeline, order])
  @@map("pipeline_stages")
}

model Client {
  id         String   @id @default(cuid())
  fullName   String
  phone      String?  @unique
  whatsappId String?
  email      String?
  source     String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deals      Deal[]
  contact    Contact?

  @@map("clients")
}

/// A broadcast-audience contact — separate from Client/Deal on purpose: uploading a base of
/// numbers here does not create sales leads or clutter the CRM board. `client` is filled in only
/// once this person actually replies to a campaign and findOrCreateLeadForPhone creates a real lead.
model Contact {
  id          String   @id @default(cuid())
  phone       String   @unique
  fullName    String?
  city        String?
  profession  String?
  category    String? // "бағыты" — free-form audience segment
  status      String?  @default("Жаңа")
  tags        String[] @default([])
  notes       String?
  clientId    String?  @unique
  client      Client?  @relation(fields: [clientId], references: [id])
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaignRecipients CampaignRecipient[]

  @@map("contacts")
}

model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String?  @unique
  category  String   @default("finished") // "material" (шикізат) | "finished" (дайын өнім)
  price     Decimal  @db.Decimal(12, 2)
  cost      Decimal  @db.Decimal(12, 2)
  unit      String   @default("шт")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deals     Deal[]

  purchaseOrderItems   PurchaseOrderItem[]
  productionOrderItems ProductionOrderItem[]
  stock                Stock[]
  stockMovements       StockMovement[]

  @@map("products")
}

/// A physical stock location. Every stock-affecting document (purchase order, production
/// consumption, manual adjustment) is scoped to one warehouse.
model Warehouse {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stock          Stock[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]

  @@map("warehouses")
}

/// Supplier/contractor a purchase order is placed with.
model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

/// "Заказ поставщику" — an order placed with a supplier for one or more products.
/// Marking items received creates StockMovement rows and increases Stock automatically.
model PurchaseOrder {
  id          String    @id @default(cuid())
  number      Int       @default(autoincrement())
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  status      String    @default("DRAFT") // DRAFT | ORDERED | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  isPaid      Boolean   @default(false)
  comment     String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items        PurchaseOrderItem[]
  transactions Transaction[]

  @@index([supplierId])
  @@index([warehouseId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  quantity    Decimal       @db.Decimal(12, 3)
  receivedQty Decimal       @default(0) @db.Decimal(12, 3)
  price       Decimal       @db.Decimal(12, 2) // purchase price per unit

  @@index([orderId])
  @@index([productId])
  @@map("purchase_order_items")
}

/// Current on-hand quantity per product+warehouse — a materialized running total kept in
/// sync with StockMovement so balance lookups don't need to aggregate the whole ledger.
model Stock {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Decimal   @default(0) @db.Decimal(12, 3)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@map("stock")
}

/// Append-only stock ledger — every accepted purchase-order delivery, production
/// consumption, or manual correction writes one row here, alongside the Stock update.
model StockMovement {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  type         String // "IN" | "OUT" | "ADJUSTMENT"
  quantity     Decimal   @db.Decimal(12, 3) // signed: positive for IN/adjustment-up, negative for OUT/adjustment-down
  balanceAfter Decimal   @db.Decimal(12, 3)
  reason       String // "purchase_order" | "production_order" | "manual_adjustment"
  refId        String? // id of the related PurchaseOrder / ProductionOrder, no FK constraint (generic)
  note         String?
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([productId, warehouseId])
  @@index([reason, refId])
  @@map("stock_movements")
}

/// Generic income/expense ledger entry — the single source of truth ОПиУ/P&L, the
/// per-employee monthly report, and the (simplified) balance sheet are all computed from.
/// Auto-posted from: Deal payments (sales_payment), sales commission (commission),
/// purchase-order receiving (material_purchase). Manually posted for everything else
/// (rent, utilities, salary, other).
model Transaction {
  id          String   @id @default(cuid())
  type        String // "INCOME" | "EXPENSE"
  category    String // sales_payment | commission | material_purchase | salary | rent | utilities | other
  amount      Decimal  @db.Decimal(12, 2) // always positive; `type` gives the sign
  description String?
  date        DateTime @default(now()) // accounting date — lets manual entries be backdated

  dealId            String?
  deal              Deal?            @relation(fields: [dealId], references: [id])
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])

  userId String? // employee this entry is about (commission/salary)
  user   User?   @relation("TransactionUser", fields: [userId], references: [id])

  createdById String
  createdBy   User     @relation("TransactionCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([type, category])
  @@index([date])
  @@index([dealId])
  @@index([userId])
  @@map("transactions")
}

model Deal {
  id              String        @id @default(cuid())
  title           String
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  prepayment      Decimal       @default(0) @db.Decimal(12, 2)
  pipelineStageId String
  pipelineStage   PipelineStage @relation("DealStage", fields: [pipelineStageId], references: [id], onDelete: Restrict)
  assignedToId    String?
  assignedTo      User?         @relation("DealAssignee", fields: [assignedToId], references: [id])
  createdById     String
  createdBy       User          @relation("DealCreator", fields: [createdById], references: [id])
  source          String?
  comment         String?
  aiEnabled       Boolean       @default(true) // AI agent auto-replies on WhatsApp while true; a manager can take over any time
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  notes            DealNote[]
  whatsappMessages WhatsAppMessage[]
  productionOrders ProductionOrder[]
  transactions     Transaction[]

  @@index([assignedToId])
  @@index([pipelineStageId])
  @@map("deals")
}

/// Free-text notes a sales rep logs against a deal — multiple entries over time, each editable by its author.
model DealNote {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@map("deal_notes")
}

/// Two-way WhatsApp message log per deal (inbound from client, outbound sent from the CRM).
model WhatsAppMessage {
  id                String   @id @default(cuid())
  dealId            String
  deal              Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  direction         String // "IN" | "OUT"
  body              String
  messageType       String   @default("text") // text | image | document | audio | video
  mediaUrl          String? // our bucket URL — Meta's own media links expire after 5 days
  mediaMimeType     String?
  fileName          String?
  whatsappMessageId String?
  status            String   @default("SENT") // SENT | DELIVERED | READ | FAILED — synced from Cloud API status webhooks
  errorMessage      String?
  sentById          String?
  sentBy            User?    @relation(fields: [sentById], references: [id])
  aiGenerated       Boolean  @default(false)
  promptTokens      Int? // Gemini usageMetadata, only set on aiGenerated messages — for cost tracking
  completionTokens  Int?
  channel           String           @default("CLOUD_API") // CLOUD_API (shared Meta bot number) | PERSONAL (a manager's own Baileys-linked WhatsApp)
  sessionId         String?
  session           WhatsAppSession? @relation(fields: [sessionId], references: [id])
  createdAt         DateTime @default(now())

  @@index([dealId])
  @@index([whatsappMessageId])
  @@map("whatsapp_messages")
}

/// A manager's own WhatsApp account, linked via the WhatsApp Web protocol (QR scan, Baileys) —
/// one per User. Kept alongside the shared Cloud API bot number so a manager can message clients
/// straight from their personal/business number while every message still lands in this CRM.
model WhatsAppSession {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  phoneNumber String? // set once connected, e.g. "+77471234567"
  status      String    @default("PENDING") // PENDING (QR issued, not scanned yet) | CONNECTED | DISCONNECTED (will auto-retry) | LOGGED_OUT (scan a fresh QR)
  qr          String? // data:image/png;base64 QR code for the connect page to display — cleared once connected
  lastError   String?
  connectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authKeys WhatsAppAuthKey[]
  messages WhatsAppMessage[]

  @@map("whatsapp_sessions")
}

/// Baileys' signal-protocol auth state (creds + prekeys) for one WhatsAppSession, persisted to
/// Postgres instead of disk so a session survives redeploys without rescanning the QR code.
model WhatsAppAuthKey {
  id        String          @id @default(cuid())
  sessionId String
  session   WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  key       String
  value     String          @db.Text
  updatedAt DateTime        @updatedAt

  @@unique([sessionId, key])
  @@map("whatsapp_auth_keys")
}

/// Singleton (id = "default") config for the WhatsApp AI sales agent.
model AiSettings {
  id                 String   @id @default("default")
  enabled            Boolean  @default(false) // global kill switch — off until reviewed and turned on deliberately
  systemPrompt       String // business context, tone, sales script, handoff rules
  model              String   @default("gemini-3.5-flash-lite")
  maxHistoryMessages Int      @default(10) // chat turns sent as context — keeps prompts (and cost) small
  maxOutputTokens    Int      @default(300)
  updatedAt          DateTime @updatedAt
  updatedById        String?
  updatedBy          User?    @relation(fields: [updatedById], references: [id])

  @@map("ai_settings")
}

/// Generic audit trail, reused for ProductionOrder etc. in later phases.
model StageHistory {
  id          String         @id @default(cuid())
  entityType  String
  entityId    String
  fromStageId String?
  fromStage   PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id])
  toStageId   String
  toStage     PipelineStage  @relation("ToStage", fields: [toStageId], references: [id])
  movedById   String
  movedBy     User           @relation(fields: [movedById], references: [id])
  movedAt     DateTime       @default(now())
  note        String?
  photoUrl    String? // optional proof-of-stage photo (bucket key) — production conveyor mainly

  @@index([entityType, entityId])
  @@map("stage_history")
}

/// Manufacturing order a sales manager opens for the production department once a deal is sold.
/// Moves through PipelineStage rows where pipeline = "PRODUCTION"; every stage move is logged in
/// StageHistory (entityType = "PRODUCTION_ORDER") for per-step worker attribution and audit.
model ProductionOrder {
  id              String        @id @default(cuid())
  dealId          String?
  deal            Deal?         @relation(fields: [dealId], references: [id])
  clientName      String
  clientPhone     String
  city            String?
  address         String?
  carBrand        String?
  carYear         String?
  carGeneration   String?
  paymentAmount   Decimal       @default(0) @db.Decimal(12, 2)
  paymentType     String? // cash | card | transfer
  remainingAmount Decimal       @default(0) @db.Decimal(12, 2)
  note            String?
  pipelineStageId String
  pipelineStage   PipelineStage @relation("ProductionOrderStage", fields: [pipelineStageId], references: [id], onDelete: Restrict)
  createdById     String
  createdBy       User          @relation("ProductionOrderCreator", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items        ProductionOrderItem[]
  transactions Transaction[]

  @@index([pipelineStageId])
  @@index([dealId])
  @@map("production_orders")
}

/// One product line within a production order — a client can order several items in one заявка.
model ProductionOrderItem {
  id               String          @id @default(cuid())
  orderId          String
  order            ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productType      String
  materialPhotoUrl String? // bucket key
  // Optional link to a catalog Product (raw material) — when set, creating this item
  // automatically deducts `quantity` from warehouse stock (see stock.ts / production-orders.ts).
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id])
  quantity         Decimal?        @db.Decimal(12, 3)
  createdAt        DateTime        @default(now())

  @@index([orderId])
  @@map("production_order_items")
}

/// Canned response a manager can insert into the WhatsApp draft with one click.
model QuickReply {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quick_replies")
}

/// Raw log of inbound webhook payloads (WhatsApp lead intake), for debugging/replay.
model InboundWebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  rawPayload Json
  dealId     String?
  processed  Boolean  @default(false)
  error      String?
  receivedAt DateTime @default(now())

  @@map("inbound_webhook_events")
}

/// A Meta-approved WhatsApp message template — the only way to message a client who hasn't
/// written in the last 24h (Cloud API rejects free-form text outside that window), so every
/// broadcast Campaign sends one of these rather than plain text.
model WhatsAppTemplate {
  id             String   @id @default(cuid())
  name           String   @unique // Meta template name: lowercase_snake_case, immutable once created
  language       String   @default("kk")
  category       String // MARKETING | UTILITY
  bodyText       String // raw template body with {{1}}, {{2}} placeholders
  variableCount  Int      @default(0)
  headerType     String? // IMAGE | DOCUMENT — null means text-only template
  headerMediaKey String? // our bucket key for the approved example file, re-uploaded to Meta on each campaign run
  headerMimeType String?
  headerFileName String? // DOCUMENT headers only
  metaTemplateId String? // id Meta returned on creation
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED | PAUSED | DISABLED — synced from Meta
  rejectedReason String?
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaigns Campaign[]

  @@map("whatsapp_templates")
}

/// A bulk send job: one approved template fanned out to an uploaded contact list.
model Campaign {
  id          String   @id @default(cuid())
  name        String
  templateId  String
  template    WhatsAppTemplate @relation(fields: [templateId], references: [id])
  status      String   @default("DRAFT") // DRAFT | SENDING | COMPLETED | FAILED
  totalCount  Int      @default(0)
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  headerMetaMediaId String? // Meta media id for the template's header file, uploaded once and reused for every recipient in this run
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  recipients CampaignRecipient[]

  @@map("campaigns")
}

/// One targeted Contact within a Campaign — tracks its own send/delivery status independent of
/// the others, since a bulk send runs as a paced background loop that can take a while.
model CampaignRecipient {
  id                String    @id @default(cuid())
  campaignId        String
  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId         String
  contact           Contact   @relation(fields: [contactId], references: [id])
  status            String    @default("PENDING") // PENDING | SENT | DELIVERED | READ | FAILED
  errorMessage      String?
  dealId            String? // the Client/Deal this recipient resolved to — replies land there, AI agent takes over
  whatsappMessageId String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([campaignId])
  @@index([contactId])
  @@index([whatsappMessageId])
  @@map("campaign_recipients")
}

// -----------------------------------------------------------------------
// Finance (Phase 3) and Warehouse (Phase 4) are both implemented now:
// Transaction above is the income/expense ledger (ОПиУ/P&L, per-employee
// commission report, simplified balance sheet all read from it); Warehouse,
// Supplier, PurchaseOrder(+Item), Stock, StockMovement cover the warehouse side.
// -----------------------------------------------------------------------
